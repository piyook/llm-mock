PROJECT_NAME=llm-mock
SERVER_PORT=8001
LLM_URL_ENDPOINT=chatgpt/chat/completions
MOCK_LLM_RESPONSE_TYPE=lorem
MAX_LOREM_PARAS=8
DEBUG=OFF
LLM_NAME=openai
LLM_MODEL="gpt-4o"
VALIDATE_REQUESTS=ON
LOG_REQUESTS=ON
RESPONSE_DELAY_MIN=0
RESPONSE_DELAY_MAX=0
STREAM=false

# EMBEDDINGS CONFIGURATION FOR TESTING
ENABLE_EMBEDDINGS_MOCK=true
EMBEDDING_DIMENSION=128
