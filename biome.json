{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!ui/src/**/*.svelte",
			"!src/data",
			"!src/request-endpoints",
			"!src/request-templates",
			"!src/response-templates",
			"!create-llmock/templates",
			"!cypress/fixtures"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
