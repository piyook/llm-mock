{
	"name": "llmock",
	"version": "3.3.2",
	"description": "A configurable mock LLM API server for testing and development",
	"main": "./src/server.ts",
	"type": "module",
	"bin": {
		"llmock": "./bin/llmock.js"
	},
	"keywords": [
		"llm",
		"mock",
		"api",
		"server",
		"testing",
		"development",
		"openai",
		"chatgpt",
		"gemini",
		"embeddings"
	],
	"author": "Piyook <contact@piyook.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/piyook/llm-mock.git"
	},
	"bugs": {
		"url": "https://github.com/piyook/llm-mock/issues"
	},
	"homepage": "https://github.com/piyook/llm-mock#readme",
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"bin/**/*",
		"src/**/*",
		"scripts/**/*",
		"ui/dist/**/*",
		"src/request-templates/**/*",
		"src/response-templates/**/*",
		".llm-mock-rc.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"postinstall": "node scripts/postinstall.mjs",
    	"ui-dev": "npm --prefix ui run dev",
    	"compile-ui": "npm --prefix ui run build",
    	"prep": "npm run compile-ui && npm pack",
    	"prepare": "husky || true",
    	"lint": "oxlint",
    	"lint-fix": "oxlint --fix",
    	"pretty": "prettier 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --check",
    	"pretty-fix": "prettier 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --write",
    	"test:unit": "vitest run",
    	"torch": "torch-it",
    	"torch:test": "torch-it --test",
    	"cypress:open": "cypress open",
    	"test:e2e": "node scripts/run-e2e.mjs",
    	"validate-branch-name": "node scripts/validate-branch-name.mjs",
    	"llmock": "node scripts/llmock.mjs",
    	"llmock:chatgpt": "node scripts/llmock.mjs --model=chatgpt",
    	"llmock:gemini": "node scripts/llmock.mjs --model=gemini",
    	"llmock:streaming": "node scripts/llmock.mjs --model=streaming",
    	"llmock:embeddings": "node scripts/llmock.mjs --model=embeddings",
    	"llmock:start:chatgpt": "node scripts/llmock.mjs start --model=chatgpt",
    	"llmock:start:gemini": "node scripts/llmock.mjs start --model=gemini",
    	"llmock:start:streaming": "node scripts/llmock.mjs start --model=streaming",
    	"llmock:start:embeddings": "node scripts/llmock.mjs start --model=embeddings",
    	"llmock:stop": "llmock stop"
	},
	"dependencies": {
		"@faker-js/faker": "^10.4.0",
		"env-paths": "^4.0.0",
		"fastify": "^5.8.5",
		"pretty-print-json": "^3.0.7",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@types/chai-json-schema": "^1.4.10",
		"@types/node": "^25.6.2",
		"chai-json-schema": "^1.5.1",
		"cypress": "^15.14.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"oxlint": "^1.63.0",
		"prettier": "3.8.3",
		"torch-it": "^2.6.1",
		"validate-branch-name": "^1.3.2",
		"vitest": "^4.1.5"
	},
	"lint-staged": {
		"src/**/*.{js,jsx,ts,tsx}": "oxlint",
		"src/**/*.{js,jsx,ts,tsx,css,scss,md}": "oxlint"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"validate-branch-name": {
		"pattern": "^(main|dev){1}$|^(feat|fix|hotfix|release|chore)/.+$",
		"errorMsg": "INVALID BRANCH NAME: use format 'feat|fix|hotfix|release|core/your-branch-name'"
	}
}
