{
	"type": "module",
	"scripts": {
		"predev": "npm run compile-ui",
		"dev": "dotenvx run -f .env -- tsx watch ./src/server.ts",
		"postinstall": "test -d ui && npm --prefix ui install || true",
		"ui-dev": "npm --prefix ui run dev",
		"compile-ui": "npm --prefix ui run build",
		"start": "docker compose up -d --force-recreate",
		"stop": "docker compose down --volumes",
		"rebuild": "docker compose down --volumes && docker compose up -d --force-recreate --build",
		"restart": "npm stop && npm start",
		"prepare": "husky || true",
		"lint": "oxlint",
		"lint-fix": "oxlint --fix",
		"pretty": "prettier 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --check",
		"pretty-fix": "prettier 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --write",
		"test:unit": "vitest run",
		"torch": "torch-it",
		"torch:test": "torch-it --test",
		"cypress:open": "cypress open",
		"serve:chatgpt": "dotenvx run -f .env.chatgpt -- tsx watch ./src/server.ts",
		"serve:gemini": "dotenvx run -f .env.gemini -- tsx watch ./src/server.ts",
		"serve:streaming": "dotenvx run -f .env.streaming -- tsx watch ./src/server.ts",
		"serve:embeddings": "dotenvx run -f .env.embeddings -- tsx watch ./src/server.ts",
		"test:chatgpt": "start-server-and-test serve:chatgpt tcp:8001 'cypress run --spec cypress/e2e/gpt-mock-spec.cy.ts'",
		"test:gemini": "start-server-and-test serve:gemini tcp:8001 'cypress run --spec cypress/e2e/gemini-mock-spec.cy.ts'",
		"test:streaming": "start-server-and-test serve:streaming tcp:8001 'cypress run --spec cypress/e2e/streaming-only-spec.cy.ts'",
		"test:embeddings": "start-server-and-test serve:embeddings tcp:8001 'cypress run --spec cypress/e2e/embeddings-spec.cy.ts'",
		"test:e2e": "npm run compile-ui && npm run test:chatgpt && npm run test:gemini && npm run test:streaming && npm run test:embeddings",
		"validate-branch-name": "bash validate-branch-name.sh"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^1.61.0",
		"@faker-js/faker": "^10.4.0",
		"@types/chai-json-schema": "^1.4.10",
		"@types/node": "^25.6.0",
		"chai-json-schema": "^1.5.1",
		"fastify": "^5.8.5",
		"pretty-print-json": "^3.0.7",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"cypress": "^15.13.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxlint": "^1.60.0",
		"prettier": "3.8.3",
		"start-server-and-test": "^3.0.2",
		"torch-it": "^2.2.0",
		"validate-branch-name": "^1.3.2"
	},
	"lint-staged": {
		"src/**/*.{js,jsx,ts,tsx}": "oxlint",
		"src/**/*.{js,jsx,ts,tsx,css,scss,md}": "oxlint"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"validate-branch-name": {
		"pattern": "^(main|dev){1}$|^(feat|fix|hotfix|release|chore)/.+$",
		"errorMsg": "INVALID BRANCH NAME: use format 'feat|fix|hotfix|release|core/your-branch-name'"
	}
}
